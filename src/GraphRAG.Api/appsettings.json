{

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=graphrag_db;Username=graphrag_user;Password=graphrag_password"
  },

  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=graphrag_db;Username=graphrag_user;Password=graphrag_password",
    "CommandTimeout": 30,
    "MaxPoolSize": 100,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },

  "SemanticKernel": {
    "AzureOpenAIEndpoint": "https://your-resource.openai.azure.com/",
    "AzureOpenAIApiKey": "your-api-key-here",
    "ChatDeploymentName": "gpt-4",
    "EmbeddingDeploymentName": "text-embedding-3-large",
    "ApiVersion": "2024-02-01",
    "MaxTokens": 2000,
    "Temperature": 0.7
  },

  "GraphRag": {
    "MaxGraphHops": 2,
    "VectorSearchTopK": 10,
    "MinSimilarityScore": 0.7,
    "GnnModelPath": "",
    "EnableGnnScoring": false,
    "MinGnnScore": 0.5
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
